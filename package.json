{
  "name": "pokedex-microfrontends",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n shell,detail,history -c auto \"npm run dev --workspace @pokedex/shell\" \"npm run dev --workspace @pokedex/pokemon-detail\" \"npm run dev --workspace @pokedex/pokemon-history\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm run build",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.42.0"
  }
}
